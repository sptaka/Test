<Window x:Class="SampleViewer.Windows.AnnotationListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="メモ一覧" Width="1100" Height="640" MinWidth="760" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Modern.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="6,0"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="CellNumber" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
            <Style x:Key="CellComment" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="ToolTip" Value="{Binding Comment}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="12">
        <!-- 絞り込み -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Padding="12,8" Margin="0,0,0,8">
            <WrapPanel>
                <TextBlock Text="カテゴリ" Style="{StaticResource ToolbarLabel}"/>
                <ComboBox x:Name="CB_Category" Width="150" Margin="0,2,16,2" SelectionChanged="Category_Changed"/>
                <TextBlock Text="状態" Style="{StaticResource ToolbarLabel}"/>
                <ComboBox x:Name="CB_Status" Width="110" Margin="0,2,16,2" SelectionChanged="Filter_Changed"/>
                <TextBlock Text="記入者" Style="{StaticResource ToolbarLabel}"/>
                <ComboBox x:Name="CB_Author" Width="130" Margin="0,2,16,2" SelectionChanged="Filter_Changed"/>
                <TextBlock Text="検索" Style="{StaticResource ToolbarLabel}"/>
                <TextBox x:Name="TB_Search" Width="200" Height="26" Margin="0,2,16,2" TextChanged="Search_Changed"
                         ToolTip="コメント・耐久ID・画像名に含まれる文字で絞り込みます"/>
                <TextBlock x:Name="TB_Count" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            </WrapPanel>
        </Border>

        <!-- 操作 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="閉じる" Width="88" Height="30" IsCancel="True" Click="Close_Click"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BT_Show" Content="画像を表示" Height="30" Padding="14,0" Margin="0,0,8,0" Click="Show_Click"
                        Style="{StaticResource PrimaryButton}" ToolTip="メイン画面で、このメモの画像・測定・耐久を表示します（行のダブルクリックと同じ）"/>
                <Button x:Name="BT_Compare" Content="比較ウィンドウで開く" Height="30" Padding="14,0" Margin="0,0,16,0" Click="Compare_Click"
                        ToolTip="選んだ行の画像を比較ウィンドウに並べます（画像に付けたメモだけが対象）"/>
                <StackPanel x:Name="SP_StatusButtons" Orientation="Horizontal"/>
                <Button x:Name="BT_Edit" Content="編集…" Height="30" Padding="14,0" Margin="8,0,8,0" Click="Edit_Click"
                        ToolTip="カテゴリ・状態・コメントを編集します（自分のメモだけ）"/>
                <Button x:Name="BT_Delete" Content="削除" Height="30" Padding="14,0" Click="Delete_Click"
                        ToolTip="メモを削除します（自分のメモだけ）"/>
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <DataGrid x:Name="DG_Memos" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF1F7"
                          Background="Transparent" RowBackground="White" AlternatingRowBackground="#FAFBFD" BorderThickness="0"
                          RowHeight="28" SelectionChanged="Selection_Changed" MouseDoubleClick="Grid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="更新日" Width="96" Binding="{Binding UpdatedAt, StringFormat=yyyy/MM/dd}" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Header="分類" Width="150" SortMemberPath="CategoryLabel">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Height="18" Padding="7,0" CornerRadius="9" Margin="6,0" BorderThickness="1" HorizontalAlignment="Left"
                                            Background="{Binding Tag.Background}" BorderBrush="{Binding Tag.Border}">
                                        <TextBlock Text="{Binding Tag.Text}" Foreground="{Binding Tag.Foreground}" FontSize="10.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="耐久ID" Width="110" Binding="{Binding DurabilityId}" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="枚数" Width="76" Binding="{Binding Pages, StringFormat={}{0:#\,0}}" ElementStyle="{StaticResource CellNumber}"/>
                        <DataGridTextColumn Header="対象" Width="56" Binding="{Binding TargetName}" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="コメント" Width="*" Binding="{Binding CommentLine}" ElementStyle="{StaticResource CellComment}"/>
                        <DataGridTextColumn Header="記入者" Width="96" Binding="{Binding Author}" ElementStyle="{StaticResource CellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="TB_Empty" Text="該当するメモはありません" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
